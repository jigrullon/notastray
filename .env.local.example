# Supabase Configuration
# Get these values from your Supabase project dashboard
# Settings -> API

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (for shop checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Firebase Configuration (for notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Twilio Configuration (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid Configuration (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@notastray.com

# Coming Soon Gate (set to "true" to enable, remove or set "false" to disable)
NEXT_PUBLIC_COMING_SOON=true
COMING_SOON_SECRET=your-secret-preview-key
# Stripe Webhook Secret (for verifying webhook signatures)
# Get this from: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Firebase Project ID (for Firestore REST API in webhook)
# Can also use NEXT_PUBLIC_FIREBASE_PROJECT_ID as fallback
FIREBASE_PROJECT_ID=your_firebase_project_id

# Google reCAPTCHA v2 (bot protection on the /lookup page)
# Create a v2 "I'm not a robot" Checkbox site at https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is inlined at BUILD time (must be set when `next build` runs).
# RECAPTCHA_SECRET_KEY is read at RUNTIME by /api/verify-captcha (keep it secret, never prefix NEXT_PUBLIC_).
# Leave both unset to skip CAPTCHA in local dev mode.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Observability — Sentry (error tracking, free tier)
# DSN values come from your Sentry project settings.
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Only needed at build time to upload source maps; leave unset locally and
# the build will skip source-map upload rather than fail.
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Observability — self-hosted Grafana Loki (structured logs / SRE dashboard)
# Base URL of the self-hosted Loki instance (see observability/), e.g.
# https://logs.notastray.com. Leave unset to disable log shipping (routes
# still log to stdout).
LOKI_PUSH_URL=
LOKI_PUSH_USERNAME=notastray-app
LOKI_PUSH_PASSWORD=your_loki_push_password

# Observability — internal business/marketing metrics API
# Shared secret Grafana's Infinity datasource sends as X-Internal-Metrics-Key
# to /api/internal/metrics/*. Generate with: openssl rand -hex 32
# Must be the exact same value set in observability/.env's
# INTERNAL_METRICS_API_KEY — it's the same secret on both sides.
INTERNAL_METRICS_API_KEY=your_internal_metrics_api_key
# Auto-provisioned by Vercel when you enable Cron Jobs for this project —
# you don't generate this yourself. Vercel sends it as
# `Authorization: Bearer <value>` on every cron invocation of
# /api/internal/rollup/daily (see vercel.json). Leave unset locally; the
# rollup route also accepts INTERNAL_METRICS_API_KEY via the header above
# for manual/local triggering.
CRON_SECRET=

# Custom Email Verification
# EMAIL_VERIFICATION_SECRET signs verification tokens (HMAC-SHA256).
# Generate with: openssl rand -base64 32
# Server-only — NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
EMAIL_VERIFICATION_SECRET=your_email_verification_secret
# NEXT_PUBLIC_APP_URL is the base URL used to build verification links.
# Build-time inlined by Next.js — set it in Vercel before the build runs.
NEXT_PUBLIC_APP_URL=https://notastray.com
