{
  "title": "NotAStray — Business & Growth",
  "uid": "notastray-business",
  "tags": ["notastray", "business", "marketing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app_url",
        "type": "textbox",
        "label": "App base URL",
        "current": { "value": "https://notastray.com", "text": "https://notastray.com" },
        "query": "https://notastray.com"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Activated tags", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "activatedTags", "text": "Activated Tags", "type": "number" }]
      }]
    },
    {
      "id": 2, "title": "Total customers", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "totalCustomers", "text": "Total Customers", "type": "number" }]
      }]
    },
    {
      "id": 3, "title": "Active subscribers", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "activeSubscribers", "text": "Active Subscribers", "type": "number" }]
      }]
    },
    {
      "id": 4, "title": "MRR", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "mrr", "text": "MRR", "type": "number" }]
      }]
    },
    {
      "id": 5, "title": "Revenue (30d)", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "revenue30d", "text": "Revenue (30d)", "type": "number" }]
      }]
    },
    {
      "id": 6, "title": "Newsletter subscribers", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/summary",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [{ "selector": "newsletterSubscribers", "text": "Newsletter Subscribers", "type": "number" }]
      }]
    },
    {
      "id": 7, "title": "Revenue & orders trend", "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "timeseries", "parser": "backend",
        "url": "$app_url/api/internal/metrics/revenue-timeseries?days=30",
        "url_options": { "method": "GET" },
        "root_selector": "series",
        "columns": [
          { "selector": "date", "text": "Time", "type": "timestamp" },
          { "selector": "revenue", "text": "Revenue", "type": "number" },
          { "selector": "newOrders", "text": "New Orders", "type": "number" }
        ]
      }]
    },
    {
      "id": 8, "title": "Subscriber growth (new vs. canceled)", "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "timeseries", "parser": "backend",
        "url": "$app_url/api/internal/metrics/revenue-timeseries?days=30",
        "url_options": { "method": "GET" },
        "root_selector": "series",
        "columns": [
          { "selector": "date", "text": "Time", "type": "timestamp" },
          { "selector": "newSubscribers", "text": "New Subscribers", "type": "number" },
          { "selector": "canceledSubscribers", "text": "Canceled", "type": "number" }
        ]
      }]
    },
    {
      "id": 9, "title": "Species split (dog vs. cat)", "type": "piechart",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/species-breakdown",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [
          { "selector": "species", "text": "Species", "type": "string" },
          { "selector": "count", "text": "Count", "type": "number" }
        ]
      }]
    },
    {
      "id": 10, "title": "Rescue Crew adoption", "type": "stat",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/rescue-crew-usage",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [
          { "selector": "ownersWithAtLeastOneContact", "text": "Owners w/ Rescue Crew", "type": "number" },
          { "selector": "viewedByFinderCount", "text": "Times Shown to a Finder", "type": "number" }
        ]
      }]
    },
    {
      "id": 11, "title": "Acquisition channel — orders (last 90d)", "type": "bargauge",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
        "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "$app_url/api/internal/metrics/acquisition?days=90",
        "url_options": { "method": "GET" },
        "root_selector": "data",
        "columns": [
          { "selector": "source", "text": "Source", "type": "string" },
          { "selector": "orders", "text": "Orders", "type": "number" }
        ]
      }]
    },
    {
      "id": 12, "title": "Data notes", "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 31 },
      "options": {
        "mode": "markdown",
        "content": "Set the **app_url** variable above (dashboard settings → Variables) to your deployed app's origin — it must match `APP_BASE_URL` in `observability/.env` exactly, or every panel below will 403 (Infinity's `allowedHosts` restriction). Revenue/subscriber trend panels read from the `daily_metrics` rollup — history only exists from whenever the Vercel Cron job (`/api/internal/rollup/daily`) started running, not retroactively. Panel queries were verified against a live Grafana + Infinity instance with mock data matching the real endpoint response shapes — see OBSERVABILITY.md's \"Local testing\" section for what was actually caught and fixed that way."
      }
    }
  ]
}
