# Copy to observability/.env (gitignored) and fill in real values before
# running `docker compose up -d`. This file configures the self-hosted
# Grafana + Loki + Caddy stack itself — separate from the main app's
# .env.local, which holds LOKI_PUSH_USERNAME/PASSWORD to authenticate *to*
# this stack.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# DNS A records for these must point at the box before Caddy can issue
# certificates, e.g. logs.notastray.com / grafana.notastray.com
LOKI_PUBLIC_DOMAIN=logs.example.com
GRAFANA_PUBLIC_DOMAIN=grafana.example.com

# Basic auth Loki's push endpoint sits behind (Loki itself has no auth).
# Same username/password the app's LOKI_PUSH_USERNAME/LOKI_PUSH_PASSWORD
# (in the main repo's .env.local / Vercel env vars) must send.
LOKI_PUSH_USERNAME=notastray-app
# Generate with: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext '<password>'
LOKI_PUSH_PASSWORD_HASH=

# Must be the EXACT SAME value as INTERNAL_METRICS_API_KEY in the app's own
# Vercel env vars — this is what the Business & Growth dashboard's Infinity
# datasource sends to authenticate to /api/internal/metrics/*.
INTERNAL_METRICS_API_KEY=

# Optional — Slack/Discord/custom webhook URL for the 5xx-spike alert
# (observability/grafana/provisioning/alerting/error-rate-alert.yml). Leave
# blank and configure a contact point via the Grafana UI instead if you
# don't want a webhook URL sitting in this file.
ALERT_WEBHOOK_URL=
